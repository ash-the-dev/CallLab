# Copy this file to .env and fill in values.
# Never commit .env.

# Voice provider: openai | gemini
AI_VOICE_PROVIDER=openai

# OpenAI Realtime (required when AI_VOICE_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=sage

# Gemini Live (required when AI_VOICE_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key

# Twilio (required to place calls)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_number

# Destination for: python run.py
PGAI_TEST_NUMBER=challenge_test_number

# Destination for: python run.py --self-test
SELF_TEST_NUMBER=your_optional_self_test_number
